# Copy to .env. The real .env is ignored by Git; never commit credentials.
# Each stage may be selected independently: groq/local ASR, deepseek/local text.
ASR_PROVIDER=groq
TEXT_PROVIDER=deepseek

# API mode: audio goes to Groq; transcript text goes to DeepSeek.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Local ASR mode: install .[media] and download the faster-whisper model.
LOCAL_ASR_MODEL=small
LOCAL_ASR_DEVICE=cpu
LOCAL_ASR_COMPUTE_TYPE=int8

# Local text mode: install .[openai], start Ollama, and pull this model first.
# Only a loopback server is accepted, so local mode cannot silently call a cloud URL.
LOCAL_TEXT_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_TEXT_MODEL=
